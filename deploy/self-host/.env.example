# Set one or both domains. Leave an unused service's domain empty.
# DNS A records must point directly to the Linux server's public IP.
MEDIA_DOMAIN=media.example.com
RELAY_DOMAIN=

# configure.mjs generates independent secrets when these are empty.
LIVEKIT_API_KEY=codelight_key
LIVEKIT_API_SECRET=
REGISTRATION_TOKEN=

# Optional LiveKit TURN/TLS. Supply certs/fullchain.pem and certs/privkey.pem.
# This template reserves TCP 443 for HTTPS; TURN/TLS uses TCP 5349.
TURN_DOMAIN=

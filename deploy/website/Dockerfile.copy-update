ARG STATIC_IMAGE
FROM ${STATIC_IMAGE}
COPY --chown=101:101 site/index.html /usr/share/nginx/html/index.html
COPY --chown=101:101 site/app.js /usr/share/nginx/html/app.js
COPY --chown=101:101 site/styles.css /usr/share/nginx/html/styles.css
COPY --chown=101:101 site/assets/icon.png /usr/share/nginx/html/assets/icon.png
COPY --chown=101:101 site/privacy.html /usr/share/nginx/html/privacy.html
COPY --chown=101:101 site/support.html /usr/share/nginx/html/support.html
COPY --chown=101:101 site/testflight.json /usr/share/nginx/html/testflight.json
COPY --chown=101:101 site/release.json /usr/share/nginx/html/release.json
COPY --chown=101:101 nginx.conf /etc/nginx/nginx.conf
COPY --chown=101:101 security-headers.conf /etc/nginx/security-headers.conf

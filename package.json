{
  "name": "codelync",
  "version": "1.0.1",
  "codelyncBuild": "2026111801",
  "private": true,
  "type": "module",
  "description": "Codelync phone companion for existing Codex, Antigravity Desktop and Claude Desktop sessions in Gateway setups",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "security:release": "node scripts/audit-public-release.mjs",
    "start": "node scripts/codelync-daemon.mjs",
    "test": "node --test test/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint src scripts test public",
    "verify": "npm run typecheck && npm run lint && npm test",
    "package": "node scripts/package-codelync.mjs",
    "start:legacy": "node scripts/launch.mjs",
    "package:codelync": "node scripts/package-codelync.mjs",
    "package:source": "node scripts/package-codelync.mjs --source-only",
    "postinstall": "node scripts/postinstall.cjs",
    "typecheck:mobile": "pnpm --filter @codelync/mobile typecheck",
    "typecheck:relay": "pnpm --filter @codelync/relay typecheck:prod",
    "typecheck:all": "pnpm typecheck && pnpm typecheck:mobile && pnpm typecheck:relay",
    "dev:mobile": "pnpm --filter @codelync/mobile start",
    "build:mac": "node scripts/build-mac-app.mjs",
    "build:mobile": "node scripts/build-mobile.mjs",
    "build:native": "sh native/build.sh && node scripts/build-desktop-runtime.mjs",
    "build:desktop": "node scripts/build-desktop-runtime.mjs"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/ws": "8.18.2",
    "esbuild": "0.27.2",
    "eslint": "9.39.5",
    "happy-dom": "21.0.4",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@codelync/wire": "workspace:*",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "livekit-server-sdk": "2.20.0",
    "proper-lockfile": "4.1.2",
    "qrcode-terminal": "0.12.0",
    "sharp": "0.35.5",
    "socket.io-client": "4.8.4",
    "tweetnacl": "1.0.3",
    "ws": "8.22.0"
  },
  "packageManager": "pnpm@10.11.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mapix/Codelync.git"
  }
}
